// NovaBridge.kt
class NovaBridge(
private val db: NovaDatabase,
private val themeManager: ThemeManager
) {
@JavascriptInterface
fun getData(request: String): String {
val req = Gson().fromJson(request, DataRequest::class.java)

text

    return when (req.type) {
        "home" -> getHomeData()
        "stats" -> getStatsData(req.period, req.category)
        "billboard" -> getBillboardData(req.chart, req.period)
        "records" -> getRecordsData(req.recordType)
        "certs" -> getCertsData(req.category)
        "hof" -> getHofData(req.period)
        "pantheon" -> getPantheonData()
        "awards" -> getAwardsData(req.year)
        else -> "{}"
    }
}

@JavascriptInterface
fun getTheme(): String {
    return Gson().toJson(themeManager.current)
}

@JavascriptInterface
fun action(actionJson: String) {
    val action = Gson().fromJson(actionJson, UserAction::class.java)
    
    when (action.type) {
        "openPopup" -> openNativePopup(action.entityType, action.entityId)
        "share" -> openShareSheet(action.shareType, action.entityId)
        "navigate" -> navigateToTab(action.tab)
    }
}
}
