    const val MAIN = "main"
    const val SETTINGS = "settings"
    const val SEARCH = "search"
    const val POPUP_TRACK = "popup/track/{trackId}"
    const val POPUP_ARTIST = "popup/artist/{artistId}"
    const val POPUP_ALBUM = "popup/album/{albumId}"
}

