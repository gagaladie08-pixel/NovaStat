        val existing = db.dailyStatsDao().getByDate(date)
        if (existing != null) {
            db.dailyStatsDao().incrementPlays(date, duration)
        } else {
            db.dailyStatsDao().insert(
                DailyStatsEntity(
                    date = date,
                    play_count = 1,
